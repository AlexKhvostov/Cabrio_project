# CabrioRide — пример файла окружения (.env)
# Скопируйте этот файл как ".env" и заполните значениями.
# Внимание: файл .env должен быть в .gitignore и не попадать в репозиторий.

# Базовые URL
BASE_URL=https://example.com/app
BACKEND_API_URL=https://example.com/app/backend/api.php

# База данных (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cabrio
DB_USER=cabrio_user
DB_PASS=change_me

# Безопасность / интеграции
SYSTEM_TOKEN=change_me
X_BOT_SECRET=change_me
BOT_TOKEN=change_me

# Яндекс.Карты
map_ya_key=YOUR_YANDEX_MAPS_API_KEY
# Частоты обновлений (сек)
map_upd_sec=30
map_upd_moving_sec=10
# Порог движения (метры)
map_move_threshold_m=25
# Обновление списка онлайн (сек)
map_users_refresh_idle_sec=60
map_users_refresh_moving_sec=20
# Сколько минут метка считается «живой»
map_live_time_min=60
# Затухание отображения на карте при выключенном GPS (сек)
map_view_fade_sec=30

# Dev mode (опционально)
# DEV_MODE=1
# DEV_OVERRIDE_ROLE=admin