[
    {
        "url": "/api/auth/telegram",
        "tests": [
            {
                "type": "1. Успех 1",
                "request": { "auth": {}, "data": { "initData": "valid_telegram_data" } },
                "expect": { "success": true, "result.message": "OK" }
            },
            {
                "type": "2. Успех 2",
                "request": { "auth": {}, "data": { "initData": "another_valid_data" } },
                "expect": { "success": true }
            },
            {
                "type": "3. Ошибка: дубликат",
                "request": { "auth": {}, "data": { "initData": "valid_telegram_data" } },
                "expect": { "success": false, "error.code": 422 }
            },
            {
                "type": "4. Ошибка: неправильный запрос",
                "request": { "foo": "bar" },
                "expect": { "success": false, "error.code": 400 }
            },
            {
                "type": "5. Ошибка: ограничение доступа",
                "request": { "auth": { "user_id": 1, "role": "guest" }, "data": { "initData": "valid_telegram_data" } },
                "expect": { "success": false, "error.code": 403 }
            },
            {
                "type": "6. Ошибка: невалидные данные",
                "request": { "auth": {}, "data": { "initData": 12345 } },
                "expect": { "success": false, "error.code": 400 }
            },
            {
                "type": "7. Ошибка: нет обязательного поля",
                "request": { "auth": {}, "data": {} },
                "expect": { "success": false, "error.code": 400 }
            },
            {
                "type": "8. Ошибка: пустой JSON",
                "request": {},
                "expect": { "success": false, "error.code": 400 }
            }
        ]
    },
