    {
        "url": "/api/users/update",
        "tests": [
            {
                "type": "Успех 1",
                "request": { "auth": { "user_id": 1, "role": "member" }, "data": { "user_id": 1, "first_name": "New", "last_name": "Name" } },
                "expect": { "success": true, "result.user_id": 1 }
            },
            {
                "type": "Успех 2",
                "request": { "auth": { "user_id": 2, "role": "member" }, "data": { "user_id": 2, "first_name": "Ivan", "last_name": "Ivanov" } },
                "expect": { "success": true, "result.user_id": 2 }
            },
            {
                "type": "Успех с ошибкой (несуществующий)",
                "request": { "auth": { "user_id": 999999, "role": "member" }, "data": { "user_id": 999999, "first_name": "Ghost", "last_name": "User" } },
                "expect": { "success": false, "error.code": 404 }
            },
            {
                "type": "Ошибка: неправильный запрос",
                "request": { "foo": "bar" },
                "expect": { "success": false, "error.code": 400 }
            },
            {
                "type": "Ошибка: ограничение доступа",
                "request": { "auth": { "user_id": 1, "role": "guest" }, "data": { "user_id": 1, "first_name": "New", "last_name": "Name" } },
                "expect": { "success": false, "error.code": 403 }
            },
            {
                "type": "Ошибка: невалидные данные",
                "request": { "auth": { "user_id": 1, "role": "member" }, "data": { "user_id": 1, "first_name": "", "last_name": "" } },
                "expect": { "success": false, "error.code": 400 }
            },
            {
                "type": "Ошибка: нет обязательного поля",
                "request": { "auth": { "user_id": 1, "role": "member" }, "data": {} },
                "expect": { "success": false, "error.code": 400 }
            },
            {
                "type": "Ошибка: пустой JSON",
                "request": {},
                "expect": { "success": false, "error.code": 400 }
            }
        ]
    },
