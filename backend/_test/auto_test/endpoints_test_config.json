    {
        "url": "/api/cars/add",
        "tests": [
            {
                "type": "Успех 1",
                "request": { "auth": { "user_id": 1, "role": "member" }, "data": { "reg_number": "A123BC", "model": "Test", "year": 2020, "color": "red", "photo": "" } },
                "expect": { "success": true, "result.car_id": 1 }
            },
            {
                "type": "Успех 2",
                "request": { "auth": { "user_id": 2, "role": "member" }, "data": { "reg_number": "B456DE", "model": "Mazda", "year": 2021, "color": "blue", "photo": "" } },
                "expect": { "success": true, "result.car_id": 2 }
            },
            {
                "type": "Успех с ошибкой (дубликат)",
                "request": { "auth": { "user_id": 1, "role": "member" }, "data": { "reg_number": "A123BC", "model": "Test", "year": 2020, "color": "red", "photo": "" } },
                "expect": { "success": false, "error.code": 422 }
            },
            {
                "type": "Ошибка: неправильный запрос",
                "request": { "foo": "bar" },
                "expect": { "success": false, "error.code": 400 }
            },
            {
                "type": "Ошибка: ограничение доступа",
                "request": { "auth": { "user_id": 1, "role": "guest" }, "data": { "reg_number": "A123BC", "model": "Test", "year": 2020, "color": "red", "photo": "" } },
                "expect": { "success": false, "error.code": 403 }
            },
            {
                "type": "Ошибка: невалидные данные",
                "request": { "auth": { "user_id": 1, "role": "member" }, "data": { "reg_number": "!!!", "model": "", "year": "notayear", "color": "", "photo": "" } },
                "expect": { "success": false, "error.code": 400 }
            },
            {
                "type": "Ошибка: нет обязательного поля",
                "request": { "auth": { "user_id": 1, "role": "member" }, "data": { "model": "Test" } },
                "expect": { "success": false, "error.code": 400 }
            },
            {
                "type": "Ошибка: пустой JSON",
                "request": {},
                "expect": { "success": false, "error.code": 400 }
            }
        ]
    },
